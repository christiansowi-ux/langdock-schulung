      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "util:ComposeTransformer",
              "version": 1,
              "parameters": {},
              "mapper": {
                "value": "TOP-KANDIDAT: {{1.taetigkeit}}\n{{1.pro_monat}} × {{1.minuten}} Min. = {{1.pro_monat * 1.minuten}} Minuten pro Monat (rund {{round(1.pro_monat * 1.minuten / 60)}} Stunden).\nLohnt einen Use-Case-Steckbrief."
              },
              "metadata": {
                "designer": {
                  "x": 600,
                  "y": -100,
                  "name": "3a · Top-Kandidat"
                },
                "restore": {},
                "expect": [
                  {
                    "name": "value",
                    "type": "text",
                    "label": "Text"
                  }
                ]
              },
              "filter": {
                "name": "Ab 600 Minuten im Monat",
                "conditions": [
                  [
                    {
                      "a": "{{1.pro_monat * 1.minuten}}",
                      "o": "number:greaterorequal",
                      "b": "600"
                    }
                  ]
                ]
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 4,
              "module": "util:ComposeTransformer",
              "version": 1,
              "parameters": {},
              "mapper": {
                "value": "KLEINER POSTEN: {{1.taetigkeit}}\n{{1.pro_monat}} × {{1.minuten}} Min. = {{1.pro_monat * 1.minuten}} Minuten pro Monat.\nVielleicht nervig, aber eher kein Start-Kandidat."
              },
              "metadata": {
                "designer": {
                  "x": 600,
                  "y": 100,
                  "name": "3b · Kleiner Posten"
                },
                "restore": {},
                "expect": [
                  {
                    "name": "value",
                    "type": "text",
                    "label": "Text"
                  }
                ]
              },
              "filter": {
                "name": "Unter 600 Minuten im Monat",
                "conditions": [
                  [
                    {
                      "a": "{{1.pro_monat * 1.minuten}}",
                      "o": "number:less",
                      "b": "600"
                    }
                  ]
                ]
              }
            }
          ]
        }
      ]
